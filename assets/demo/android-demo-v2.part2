),visibility .7s}.room.show{opacity:1;visibility:visible;transform:none}.room-grid{position:absolute;inset:0;opacity:.42;background-image:linear-gradient(to right,rgba(16,24,39,.055) 1px,transparent 1px),linear-gradient(to bottom,rgba(16,24,39,.04) 1px,transparent 1px);background-size:80px 80px;mask-image:radial-gradient(circle at 50% 50%,#000 0 33%,transparent 76%)}
.room-top{position:absolute;left:clamp(16px,3vw,38px);right:clamp(16px,3vw,38px);top:max(15px,env(safe-area-inset-top));z-index:6;display:flex;justify-content:space-between;align-items:center;gap:1rem;color:var(--ink2);font-size:.66rem;font-weight:800;letter-spacing:.105em;text-transform:uppercase}.returning{display:flex;align-items:center;gap:.55rem}.returning .track{width:4.6rem;height:2px;background:rgba(16,24,39,.12);overflow:hidden}.returning .track i{display:block;width:100%;height:100%;background:var(--accent);transform-origin:left;animation:returning 34s linear forwards}@keyframes returning{to{transform:scaleX(.12)}}
.bedscene{position:absolute;left:0;right:0;top:8%;bottom:0;z-index:1;overflow:hidden;pointer-events:none}.windowglow{position:absolute;left:50%;top:4%;width:min(58vw,620px);height:48%;transform:translateX(-50%);background:radial-gradient(ellipse at 50% 20%,rgba(255,255,255,.96),rgba(255,255,255,.25) 45%,transparent 72%);filter:blur(2px)}.curtain{position:absolute;right:-5%;top:0;width:34%;height:72%;background:repeating-linear-gradient(90deg,rgba(104,120,131,.05) 0 18px,rgba(104,120,131,.13) 19px 26px,rgba(104,120,131,.04) 27px 46px);filter:blur(.6px);transform:skewX(-2deg)}.patient{position:absolute;left:50%;bottom:8%;width:min(54vw,520px);height:min(52vh,440px);transform:translateX(-50%);filter:drop-shadow(0 24px 35px rgba(16,24,39,.14))}.pillow{position:absolute;left:30%;top:11%;width:43%;height:29%;border-radius:44% 48% 36% 40%;background:linear-gradient(145deg,#f8f5ed,#d9d4c8);transform:rotate(-5deg)}.head{position:absolute;left:44%;top:13%;width:18%;aspect-ratio:.78;border-radius:46% 47% 44% 42%;background:linear-gradient(145deg,#6c5e54,#3a3430);opacity:.38;filter:blur(5px)}.torso{position:absolute;left:22%;right:17%;bottom:18%;height:51%;border-radius:46% 43% 8% 8%;background:linear-gradient(160deg,#bbc6c6,#8ca1a2);transform:rotate(-1deg);animation:breathe 3.8s ease-in-out infinite;transform-origin:bottom center}@keyframes breathe{50%{transform:rotate(-1deg) scaleY(1.018)}}.blanket{position:absolute;left:12%;right:8%;bottom:0;height:45%;border-radius:48% 52% 5% 5%;background:linear-gradient(180deg,#d8ddd8,#b8c0bb);box-shadow:inset 0 12px 24px rgba(255,255,255,.22)}.hand{position:absolute;left:51%;top:48%;width:13%;height:22%;border-radius:45% 50% 34% 36%;background:#aa8d7c;opacity:.54;transform:rotate(-24deg);filter:blur(1.8px)}.rail{position:absolute;left:8%;right:5%;bottom:19%;height:2px;background:#7a8584;box-shadow:0 0 0 1px rgba(255,255,255,.4)}.rail:before,.rail:after{content:"";position:absolute;bottom:-72px;width:4px;height:74px;background:#858e8d}.rail:before{left:7%}.rail:after{right:8%}
.vignette{position:absolute;inset:0;background:linear-gradient(180deg,rgba(243,237,223,.16),rgba(243,237,223,.3) 52%,rgba(243,237,223,.92) 88%),radial-gradient(circle at 50% 48%,transparent 0 28%,rgba(243,237,223,.15) 62%,rgba(243,237,223,.65) 100%)}
.encounter{position:absolute;inset:0;z-index:4;display:grid;place-items:center;padding:4.4rem 1rem 3rem}.panel{width:min(740px,calc(100vw - 2rem));min-height:min(650px,calc(100svh - 7rem));display:flex;flex-direction:column;justify-content:flex-end;align-items:center;text-align:center}.identity{margin-bottom:auto;padding-top:clamp(1.8rem,5vh,3.5rem);opacity:.82}.identity p{margin:0;color:var(--ink2);font-size:.66rem;font-weight:850;letter-spacing:.15em;text-transform:uppercase}.identity strong{display:block;margin-top:.4rem;font-family:var(--display);font-size:clamp(2rem,5vw,3rem);font-weight:400}.dialog{width:min(590px,100%);padding:clamp(1.15rem,3vw,1.65rem);border:1px solid rgba(16,24,39,.16);background:rgba(255,250,240,.91);backdrop-filter:blur(8px);box-shadow:0 18px 54px rgba(16,24,39,.13)}.speaker{margin:0 0 .72rem;color:var(--accent);font-size:.64rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}.line{min-height:5.5rem;margin:0;display:grid;place-items:center;font-family:var(--display);font-size:clamp(1.8rem,4.8vw,3.35rem);line-height:1.03;letter-spacing:-.025em;text-wrap:balance}.line.you{font-family:var(--body);font-size:clamp(1.2rem,3vw,1.95rem);font-weight:650;line-height:1.25}.waiting{margin:.9rem 0 0;color:var(--ink2);font-size:.7rem;opacity:0;transition:opacity .35s}.waiting.show{opacity:1}.wave{height:2.2rem;margin:.55rem 0 0;display:flex;align-items:center;justify-content:center;gap:.23rem;opacity:.2}.wave.live{opacity:.9}.wave i{width:3px;height:.7rem;border-radius:10px;background:var(--accent);animation:wave .78s ease-in-out infinite;animation-play-state:paused}.wave.live i{animation-play-state:running}.wave i:nth-child(2n){animation-delay:-.2s}.wave i:nth-child(3n){animation-delay:-.42s}@keyframes wave{0%,100%{transform:scaleY(.45)}50%{transform:scaleY(2.35)}}
.hold{position:relative;width:min(390px,100%);min-height:4rem;margin:1.05rem auto 0;border-radius:999px;overflow:hidden;background:var(--ink);color:var(--paper);font-weight:850;cursor:pointer;user-select:none;touch-action:none;box-shadow:0 12px 34px rgba(16,24,39,.22);transition:.15s var(--ease)}.hold.down{transform:scale(.985);background:var(--accent)}.fill{position:absolute;inset:0 auto 0 0;width:calc(var(--p,0)*1%);background:rgba(255,255,255,.13)}.hold-inner{position:rela
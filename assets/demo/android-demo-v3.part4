,base=0,start=0,raf=0,down=false,busy=false,deadline=0,timerId=0,transitioning=false,voices=[];
const canSpeak='speechSynthesis' in window&&'SpeechSynthesisUtterance' in window;
const landingHTML=fetch('android.html',{cache:'no-store'}).then(r=>r.ok?r.text():null).catch(()=>null);
function loadVoices(){if(canSpeak)voices=speechSynthesis.getVoices()||[]} loadVoices(); if(canSpeak)speechSynthesis.addEventListener('voiceschanged',loadVoices);
function pickVoice(role){const en=voices.filter(v=>/^en[-_]/i.test(v.lang||'')),pool=en.length?en:voices;if(!pool.length)return null;const hints=role==='attending'?['david','mark','guy','ryan','daniel','george']:['zira','aria','jenny','samantha','sonia','libby'];return pool.find(v=>hints.some(h=>(v.name||'').toLowerCase().includes(h)))||pool[role==='attending'?Math.min(1,pool.length-1):0]}
function say(text,role='patient',done){if(!canSpeak){setTimeout(()=>done&&done(),Math.min(2400,Math.max(650,text.length*38)));return}speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(text),v=pickVoice(role);if(v)u.voice=v;u.lang='en-US';u.rate=role==='attending'?1.03:.91;u.pitch=role==='attending'?.82:1.01;let finished=false;const end=()=>{if(finished)return;finished=true;done&&done()};u.onend=end;u.onerror=end;speechSynthesis.speak(u);setTimeout(end,Math.min(3600,Math.max(900,text.length*55)))}
function live(on){wave.classList.toggle('live',!!on)}
function setBrief(main,sub=''){briefLine.classList.remove('impact');void briefLine.offsetWidth;briefLine.innerHTML=main;briefSub.textContent=sub;briefLine.classList.add('impact')}
function startTimer(){deadline=Date.now()+59000;const tick=()=>{const sec=Math.max(0,Math.ceil((deadline-Date.now())/1000)),txt='00:'+String(sec).padStart(2,'0');briefTimer.textContent=txt;roomTimer.textContent=txt};tick();timerId=setInterval(tick,250)}
function opening(){
 setBrief('');
 setTimeout(()=>{setBrief('<span class="accent">YOU.</span>');say('You.','attending')},350);
 setTimeout(()=>{setBrief('BED 23.');say('Bed twenty-three.','attending')},1250);
 setTimeout(()=>{setBrief('34-year-old woman.<br><span class="accent">Chest pain.</span>');briefSub.textContent='';say('Thirty-four-year-old woman. Chest pain.','attending')},2300);
 setTimeout(()=>{setBrief('TAKE THE HISTORY.');briefSub.textContent='';say('Take the history.','attending')},3750);
 setTimeout(()=>{setBrief('We’ll come back<br><span class="accent">to you.</span>');briefSub.textContent='Be ready to present her.';pressure.classList.add('show');startTimer();say("We'll come back to you.",'attending')},4950);
 setTimeout(enterRoom,6900);
}
function enterRoom(){brief.classList.add('leave');room.classList.add('show');setTimeout(()=>patient("Doctor... I've got this pain in my chest. It started this morning.",prepare,true),650)}
function role(r){const isPatient=r==='patient';speaker.textContent=isPatient?'Patient':'Your turn';patientLine.style.fontFamily=isPatient?'Georgia,Times New Roman,serif':'Inter,ui-sans-serif,system-ui,sans-serif';patientLine.style.fontWeight=isPatient?'400':'750'}
function type(text,d=1050,done){patientLine.innerHTML='';const n=document.createTextNode(''),c=document.createElement('span');c.className='caret';patientLine.append(n,c);const t=performance.now();function tick(now){const q=Math.min(1,(now-t)/d);n.nodeValue=text.slice(0,Math.max(1,Math.floor(text.length*q)));if(q<1)requestAnimationFrame(tick);else{n.nodeValue=text;c.remove();done&&done()}}requestAnimationFrame(tick)}
function patient(text,next,openingLine=false){role('patient');hold.hidden=true;sub.hidden=true;waiting.classList.remove('show');signal.classList.remove('show');live(true);let typed=false,spoken=false,advanced=false;const advance=()=>{if(advanced||!typed||!spoken)return;advanced=true;setTimeout(()=>next&&next(),openingLine?850:500)};type(text,Math.min(1800,Math.max(950,text.length*24)),()=>{typed=true;advance()});say(text,'patient',()=>{spoken=true;live(false);advance()})}
function prepare(){role('doctor');patientLine.textContent='';p=base=0;hold.style.setProperty('--p','0');hold.hidden=false;sub.hidden=false;holdText.textContent=ti?'HOLD — KEEP GOING':'HOLD TO SPEAK';sub.textContent=ti?'She is waiting. Keep the history moving.':'No choices. Say what you would ask.';setTimeout(()=>waiting.classList.add('show'),450)}
function render(){const text=turns[ti].doctor,q=Math.max(0,Math.min(1,p)),n=Math.floor(text.length*q);patientLine.innerHTML='';patientLine.append(document.createTextNode(text.slice(0,n)));if(q>0&&q<1){const c=document.createElement('span');c.className='caret';patientLine.append(c)}hold.style.setProperty('--p',String(q*100))}
function startHold(){if(down||busy||hold.hidden)return;down=true;hold.classList.add('down');holdText.textContent='SPEAKING…';waiting.classList.remove('show');live(true);start=performance.now();base=p;const words=turns[ti].doctor.split(/\s+/),wi=Math.min(words.length-1,Math.floor(words.length*p));say(words.slice(wi).join(' ')||turns[ti].doctor,'attending');function tick(now){if(!down)return;p=Math.min(1,base+(now-start)/2300);render();if(p>=1){finish();return}raf=requestAnimationFrame(tick)}raf=requestAnimationFrame(tick)}
function stopHold(){if(!down)return;down=false;cancelAnimationFrame(raf);if(canSpeak)speechSynthesis.cancel();hold.classList.remove('down');live(false);if(p<1){holdText.textContent=ti?'HOLD — KEEP GOING':'HOLD TO CONTINUE';setTimeout(()=>waiting.classList.add('show'),300)}}
async function finish(){down=false;busy=true;cancelAnimationFrame(raf);if(canSpeak)speechSynthesis.cancel();p=1;render();hold.classList.remove('down');hold.hidden=true;sub.hidden=true;waiting.classList.remove('show');live(false);const key=turns[ti].capture;signal.textContent=key==='provoking'?'Provoking factor captured':'Radiation captured';signal.classList.add('show');document.querySelector(`[data-check="${key}"]`)?.classList.add('done');setTimeout(()=>patient(turns[ti].response,()=>{if(ti<turns.length-1){ti++;busy=false;setTimeout(prepare,300)}else setTimeout(showReturn,650)}),700)}
function showReturn(){clearInterval(timerId);room.classList.remove('show');returnScene.classList.add('show');say("How's the patient in bed twenty-three?",'attending');setTi
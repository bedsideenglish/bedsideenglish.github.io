tive;min-height:4rem;display:flex;align-items:center;justify-content:center;gap:.62rem}.mic{width:1.05rem;height:1.05rem}.sub{margin:.6rem 0 0;color:var(--ink2);font-size:.66rem;line-height:1.4}.signal-area{min-height:3rem;margin-top:.7rem;display:flex;align-items:center;justify-content:center}.signal{padding:.48rem .74rem;border:1px solid var(--positive);background:var(--positiveWash);color:var(--positive);font-size:.62rem;font-weight:850;letter-spacing:.095em;text-transform:uppercase;opacity:0;transform:translateY(8px) scale(.96);transition:.42s var(--ease)}.signal.show{opacity:1;transform:none}.checks{display:flex;justify-content:center;gap:.45rem;flex-wrap:wrap;margin-top:.25rem}.check{padding:.45rem .64rem;border:1px solid rgba(16,24,39,.12);background:rgba(255,250,240,.72);color:var(--ink2);font-size:.58rem;font-weight:820;letter-spacing:.07em;text-transform:uppercase;opacity:0;transform:translateY(7px) scale(.96);transition:.38s var(--ease)}.check.done{border-color:var(--positive);background:var(--positiveWash);color:var(--positive);opacity:1;transform:none}.check.done:before{content:"✓ ";font-weight:900}.caret{display:inline-block;width:.08em;height:.9em;margin-left:.08em;background:var(--accent);vertical-align:-.06em;animation:blink .72s steps(1) infinite}@keyframes blink{50%{opacity:0}}

/* ATTENDING CALLBACK */
.callback{position:absolute;inset:0;z-index:24;display:grid;place-items:center;padding:1.4rem;background:#0f1826;color:#f4ecde;opacity:0;visibility:hidden;transition:.45s var(--ease)}.callback.show{opacity:1;visibility:visible}.callback-inner{width:min(820px,94vw)}.callback-tag{margin:0 0 1.1rem;color:#dda185;font-size:.66rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}.callback h2{max-width:13ch;margin:0;font-family:var(--display);font-size:clamp(3.3rem,9vw,7.6rem);font-weight:400;line-height:.9;letter-spacing:-.035em}.callback h2 em{display:block;color:#ebb08e;font-style:normal}.callback .silence{margin:1.3rem 0 0;color:rgba(255,255,255,.5);font-size:.7rem;font-weight:760;letter-spacing:.085em;text-transform:uppercase}.callback .blinkdot{display:inline-block;width:.45rem;height:.45rem;margin-left:.4rem;border-radius:50%;background:#e9a684;animation:blink .9s steps(1) infinite}

/* REVEAL */
.truth{position:absolute;inset:0;z-index:30;display:grid;place-items:center;padding:1.5rem;background:#101827;color:#f4ecde;opacity:0;visibility:hidden;transition:.55s var(--ease)}.truth.show{opacity:1;visibility:visible}.truth-inner{width:min(900px,96vw);text-align:center}.truth-kicker{margin:0 0 1rem;color:#e3a486;font-size:.68rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}.truth h2{margin:0;font-family:var(--display);font-size:clamp(3.2rem,9vw,7rem);font-weight:400;line-height:.9;letter-spacing:-.035em}.truth h2 span{display:block;color:#edb18d}.truth-copy{max-width:37rem;margin:1.15rem auto 0;color:rgba(255,255,255,.72);font-size:clamp(.88rem,2vw,1rem);line-height:1.55}.brand{margin:1.4rem 0 0;color:#fff;font-size:.74rem;font-weight:860;letter-spacing:.14em;text-transform:uppercase}.brand b{color:#e6a887}.ctas{width:min(520px,100%);margin:1.4rem auto 0;display:grid;grid-template-columns:1fr 1fr;gap:.65rem}.cta{min-height:3.25rem;padding:.55rem .85rem;display:flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,.45);text-decoration:none;font-size:.7rem;font-weight:820}.cta.primary{background:#f4ecde;color:#101827;border-color:#f4ecde}.cta:hover{transform:translateY(-2px)}.continue{margin-top:1.05rem;padding:.5rem;background:none;color:rgba(255,255,255,.67);font-size:.67rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase;cursor:pointer}.continue:hover{color:#fff}

.morph{position:fixed;z-index:100;border:1px solid rgba(255,255,255,.25);background:#f4ecde;box-shadow:0 28px 90px rgba(0,0,0,.42);overflow:hidden;pointer-events:none;transform-origin:top left;transition:transform .95s var(--easeInOut),border-radius .95s var(--easeInOut)}.morph .cover{position:absolute;inset:0;display:grid;place-items:center;background:#f4ecde;color:#101827;transition:opacity .3s .42s}.morph.go .cover{opacity:0}.morph .cover b{width:4rem;height:4rem;display:grid;place-items:center;background:#101827;color:#f4ecde;font-family:var(--display);font-size:2rem}.morph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top;opacity:0;transition:opacity .32s .43s}.morph.go img{opacity:1}

@media(max-width:700px){.brief h1{font-size:clamp(3.2rem,15vw,5.3rem)}.brief-card{width:min(94vw,620px)}.door{width:52vw}.room-top{font-size:.56rem}.returning .track{width:2.7rem}.encounter{padding:4.2rem .65rem 1.35rem}.panel{min-height:calc(100svh - 5.5rem)}.identity{padding-top:1.3rem}.dialog{padding:1rem .9rem}.line{min-height:5rem}.patient{width:85vw;height:48vh;bottom:12%}.truth h2{font-size:clamp(3rem,15vw,5.1rem)}.ctas{grid-template-columns:1fr}.callback h2{font-size:clamp(3.4rem,15vw,5.7rem)}}
@media(max-width:420px){.brief-top{font-size:.58rem}.brief-card{padding:1.3rem}.instruction{font-size:.86rem}.go{min-height:3.5rem}.identity strong{font-size:2rem}.line{font-size:clamp(1.72rem,9vw,2.55rem)}.line.you{font-size:1.2rem}.hold{min-height:3.7rem}.hold-inner{min-height:3.7rem}.truth-copy{font-size:.86rem}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.001ms!important;animation-delay:0ms!important;transition-duration:.001ms!important}}
</style>
</head>
<body>
<main class="stage" id="stage">
  <button class="skip" id="skip" type="button">Skip preview →</button>

  <section class="brief" i
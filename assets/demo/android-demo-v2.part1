<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#101827">
<title>Bedside English — Bed 23</title>
<meta name="description" content="An immersive speaking preview of Bedside English: Talk & Train.">
<meta property="og:title" content="Bed 23. Chest pain. You're up.">
<meta property="og:description" content="A short interactive speaking preview of Bedside English.">
<meta property="og:image" content="https://boyskier.github.io/bedside-english/assets/social/og-cover.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#101827;--ink2:#586274;--paper:#f3eddf;--paper2:#e9e0cf;--paper3:#fffaf0;
  --rule:rgba(16,24,39,.16);--accent:#c55435;--accent2:#f1b78f;--positive:#237557;
  --positiveWash:#e4f0e9;--shadow:rgba(10,16,27,.18);--deep:rgba(8,13,22,.35);
  --display:"Instrument Serif",Georgia,serif;--body:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;
  --ease:cubic-bezier(.2,.8,.2,1);--easeInOut:cubic-bezier(.65,0,.35,1)
}
*{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;font-family:var(--body);background:var(--ink);color:var(--paper);-webkit-font-smoothing:antialiased}body{overflow:hidden}button,a{font:inherit;color:inherit}button{border:0}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}:focus-visible{outline:3px solid #fff;outline-offset:4px}
.stage{position:fixed;inset:0;overflow:hidden;background:#101827}
.skip{position:absolute;right:max(16px,env(safe-area-inset-right));top:max(16px,env(safe-area-inset-top));z-index:40;padding:.5rem .2rem;background:none;color:rgba(255,255,255,.6);font-size:.73rem;font-weight:700;text-decoration:underline;cursor:pointer}.skip:hover{color:#fff}.stage.in-room .skip{color:rgba(16,24,39,.42)}.stage.in-room .skip:hover{color:var(--ink)}

/* ROUNDING BRIEF */
.brief{position:absolute;inset:0;z-index:20;display:grid;grid-template-rows:auto 1fr auto;background:
  radial-gradient(circle at 50% 44%,rgba(79,105,135,.18),transparent 34rem),
  linear-gradient(180deg,#111a2a 0%,#0d1522 100%);transition:opacity .65s var(--ease),transform .8s var(--ease)}
.brief.exit{opacity:0;transform:scale(1.035);pointer-events:none}
.brief-top{display:flex;align-items:center;gap:.72rem;padding:max(18px,env(safe-area-inset-top)) clamp(18px,4vw,46px) 0;color:rgba(255,255,255,.63);font-size:.68rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.pulse-dot{width:.48rem;height:.48rem;border-radius:50%;background:#da7556;box-shadow:0 0 0 .35rem rgba(218,117,86,.12)}
.corridor{position:absolute;inset:0;pointer-events:none;opacity:.58}.corridor:before,.corridor:after{content:"";position:absolute;top:14%;bottom:8%;width:1px;background:linear-gradient(transparent,rgba(255,255,255,.14),transparent)}.corridor:before{left:28%}.corridor:after{right:28%}.door{position:absolute;left:50%;bottom:7%;width:min(32vw,300px);height:min(58vh,520px);transform:translateX(-50%);border:1px solid rgba(255,255,255,.1);background:linear-gradient(90deg,rgba(255,255,255,.025),rgba(255,255,255,.05),rgba(255,255,255,.02));box-shadow:0 0 90px rgba(0,0,0,.25) inset}.room-plate{position:absolute;left:50%;top:19%;transform:translateX(-50%);padding:.42rem .72rem;border:1px solid rgba(255,255,255,.2);background:#121b2a;color:#e9edf4;font-size:.72rem;font-weight:800;letter-spacing:.18em}
.brief-center{position:relative;z-index:2;display:grid;place-items:center;padding:5rem 1.25rem 2rem}.brief-card{width:min(680px,92vw);padding:clamp(1.6rem,4vw,2.65rem);border:1px solid rgba(255,255,255,.15);background:rgba(14,23,37,.76);backdrop-filter:blur(9px);box-shadow:0 28px 100px rgba(0,0,0,.32)}
.attending{margin:0 0 1.25rem;color:#e0a184;font-size:.68rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}.bedline{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1.15rem;padding-bottom:.9rem;border-bottom:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.63);font-size:.72rem;font-weight:760;letter-spacing:.11em;text-transform:uppercase}.bedline strong{color:#fff}.brief h1{max-width:13ch;margin:0;font-family:var(--display);font-size:clamp(3rem,8vw,6.9rem);font-weight:400;line-height:.88;letter-spacing:-.035em}.brief h1 em{display:block;color:#e8ab8b;font-style:normal}.instruction{max-width:31rem;margin:1.45rem 0 0;color:rgba(255,255,255,.76);font-size:clamp(.9rem,1.8vw,1.02rem);line-height:1.6}.instruction strong{color:#fff}.go{width:100%;min-height:3.7rem;margin-top:1.7rem;padding:0 1.2rem;display:flex;align-items:center;justify-content:space-between;background:#f2eadb;color:#111927;font-weight:850;letter-spacing:.035em;cursor:pointer;transition:.16s var(--ease)}.go:hover{background:#fff;transform:translateY(-2px)}.go .arrow{font-size:1.2rem}.brief-foot{position:relative;z-index:2;padding:0 clamp(18px,4vw,46px) max(18px,env(safe-area-inset-bottom));color:rgba(255,255,255,.38);font-size:.62rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase}

/* ROOM */
.room{position:absolute;inset:0;z-index:10;background:var(--paper);color:var(--ink);opacity:0;visibility:hidden;transform:scale(1.02);transition:opacity .7s var(--ease),transform .9s var(--ease
eturning b{color:var(--ink);font-variant-numeric:tabular-nums}
.bedscene{position:absolute;left:50%;top:50%;width:min(980px,102vw);height:min(760px,92vh);transform:translate(-50%,-46%);pointer-events:none;opacity:.27}.curtain{position:absolute;left:8%;top:7%;width:20%;height:76%;border-left:2px solid #243449;border-right:1px solid #243449;background:repeating-linear-gradient(90deg,rgba(36,52,73,.18) 0 10px,transparent 10px 22px);filter:blur(.2px)}.bed{position:absolute;left:27%;right:15%;bottom:13%;height:25%;border:4px solid #27384c;border-radius:18px 18px 10px 10px;transform:skewX(-5deg)}.rail{position:absolute;left:20%;right:7%;bottom:28%;height:12%;border:4px solid #27384c;border-bottom:0;border-radius:18px 18px 0 0}.patient-shape{position:absolute;left:44%;bottom:34%;width:31%;height:26%;transform:rotate(-9deg);animation:breathe 3.6s ease-in-out infinite;transform-origin:65% 85%}.torso{position:absolute;left:0;right:0;bottom:0;height:58%;border-radius:55% 42% 20% 20%;background:#26384c}.head{position:absolute;right:3%;top:0;width:28%;aspect-ratio:1;border-radius:50%;background:#26384c}.hand{position:absolute;left:31%;top:35%;width:23%;height:13%;border-radius:55% 45% 55% 45%;background:#506276;transform:rotate(18deg)}@keyframes breathe{0%,100%{transform:rotate(-9deg) scaleY(1)}50%{transform:rotate(-9deg) scaleY(1.025)}}
.panel{position:absolute;left:50%;top:50%;z-index:4;width:min(700px,calc(100vw - 28px));min-height:min(600px,calc(100svh - 110px));transform:translate(-50%,-48%);display:flex;flex-direction:column;justify-content:center;align-items:center;padding:clamp(22px,4vw,40px);border:1px solid rgba(16,24,39,.17);background:rgba(255,250,240,.91);box-shadow:0 26px 70px rgba(39,49,63,.18);backdrop-filter:blur(8px);text-align:center}.patient-label{margin:0 0 8px;color:#697384;font-size:10px;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.patient-line{min-height:118px;margin:0;display:grid;place-items:center;font-family:Georgia,"Times New Roman",serif;font-size:clamp(29px,5vw,48px);line-height:1.06;letter-spacing:-.025em;text-wrap:balance}.waiting{margin:8px 0 0;color:var(--red);font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;opacity:0;transform:translateY(5px);transition:.35s}.waiting.show{opacity:1;transform:none}.wave{height:34px;margin:10px 0 4px;display:flex;align-items:center;justify-content:center;gap:4px;color:var(--red);opacity:.22}.wave.live{opacity:1}.wave i{display:block;width:3px;height:10px;border-radius:999px;background:currentColor;animation:wave .72s ease-in-out infinite;animation-play-state:paused}.wave.live i{animation-play-state:running}.wave i:nth-child(2n){animation-delay:-.16s}.wave i:nth-child(3n){animation-delay:-.34s}.wave i:nth-child(5n){animation-delay:-.52s}@keyframes wave{0%,100%{transform:scaleY(.45)}50%{transform:scaleY(2.4)}}
.hold{position:relative;width:min(330px,94%);height:62px;margin:14px auto 0;border:1px solid var(--ink);border-radius:999px;overflow:hidden;background:var(--ink);color:var(--paper2);font-size:12px;font-weight:900;letter-spacing:.05em;user-select:none;touch-action:none;transition:transform .12s,background .15s}.hold.down{transform:scale(.988);background:var(--red)}.fill{position:absolute;left:0;top:0;bottom:0;width:calc(var(--p,0)*1%);background:rgba(255,255,255,.14)}.hold-inner{position:relative;min-height:60px;display:flex;align-items:center;justify-content:center;gap:10px}.mic{width:17px;height:17px}.sub{margin:7px 0 0;color:#697384;font-size:11px;line-height:1.4}.signal-area{min-height:42px;margin-top:10px;display:flex;align-items:center;justify-content:center}.signal{padding:8px 12px;border:1px solid var(--positive);background:#e9f4ee;color:var(--positive);font-size:10px;font-weight:900;letter-spacing:.11em;text-transform:uppercase;opacity:0;transform:translateY(8px) scale(.96);transition:.42s var(--ease)}.signal.show{opacity:1;transform:none}.checks{display:flex;justify-content:center;gap:7px;flex-wrap:wrap;margin-top:4px}.check{padding:7px 10px;border:1px solid rgba(16,24,39,.13);background:rgba(255,250,240,.72);color:#697384;font-size:9px;font-weight:850;letter-spacing:.08em;text-transform:uppercase;opacity:0;transform:translateY(7px) scale(.96);transition:.38s var(--ease)}.check.done{border-color:var(--positive);background:#e9f4ee;color:var(--positive);opacity:1;transform:none}.check.done::before{content:"✓ ";font-weight:900}.caret{display:inline-block;width:.08em;height:.9em;margin-left:.08em;background:var(--red);vertical-align:-.06em;animation:blink .72s steps(1) infinite}@keyframes blink{50%{opacity:0}}

/* ATTENDING RETURN / REVEAL */
.return{position:absolute;inset:0;z-index:30;display:grid;place-items:center;padding:24px;background:#0b121e;color:#f7f1e4;opacity:0;visibility:hidden;transition:.45s}.return.show{opacity:1;visibility:visible}.return-inner{width:min(820px,94vw);text-align:center}.return-kicker{margin:0 0 20px;color:rgba(247,241,228,.52);font-size:11px;font-weight:900;letter-spacing:.2em;text-transform:uppercase}.return-question{margin:0;font-family:Georgia,"Times New Roman",serif;font-size:clamp(42px,8vw,84px);font-weight:400;line-height:1;letter-spacing:-.035em}.return-wait{margin:20px 0 0;color:rgba(247,241,228,.52);font-size:10px;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.truth{position:absolute;inset:0;z-index:35;display:grid;place-items:center;padding:24px;background:var(--ink);color:var(--paper2);opacity:0;visibility:hidden;transition:.48s}.truth.show{opacity:1;visibility:visible}.truth-inner{width:min(900px,96vw);text-align:center}.truth-kicker{margin:0 0 14px;color:#ffab87;font-size:10px;font-weight:900;letter-spacing:.16em;text-transform:uppercase}.truth h2{margin:0;font-family:Georgia,"Times New Roman",serif;font-size:clamp(44px,8vw,82px);font-weight:400;line-height:.94;letter-spacing:-.035em}.truth h2 span{display:block;color:#ffab87}.truth-copy{margin:18px auto 0;color:#d8d2c7;font-size:clamp(14px,2vw,17px)}.ctas{margin:26px a
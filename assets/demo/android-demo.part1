<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#f5efdc">
<title>Bedside English — Interactive speaking preview</title>
<meta name="description" content="An interactive speaking preview of Bedside English: Talk & Train.">
<meta property="og:title" content="A patient is waiting. What would you say?"><meta property="og:description" content="An interactive speaking preview of Bedside English."><meta property="og:image" content="https://bedsideenglish.github.io/assets/social/og-cover.png">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.css"><link rel="stylesheet" href="tokens.css">
<style>
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--color-paper);color:var(--color-ink);font-family:var(--font-body);-webkit-font-smoothing:antialiased}body{overflow:hidden}button,a{font:inherit;color:inherit}button{-webkit-tap-highlight-color:transparent}img{display:block;max-width:100%}:focus-visible{outline:3px solid var(--color-focus);outline-offset:4px}[hidden]{display:none!important}
.preview{position:fixed;inset:0;z-index:10;overflow:hidden;background:radial-gradient(circle at 50% 38%,var(--color-accent-wash),transparent 31rem),var(--color-paper)}
.grid{position:absolute;inset:0;background-image:linear-gradient(to right,color-mix(in oklch,var(--color-rule) 58%,transparent) 1px,transparent 1px),linear-gradient(to bottom,color-mix(in oklch,var(--color-rule) 45%,transparent) 1px,transparent 1px);background-size:clamp(3.5rem,7vw,6rem) clamp(3.5rem,7vw,6rem);mask-image:radial-gradient(circle at center,#000 0 35%,transparent 74%);opacity:.58}
.meta{position:absolute;left:clamp(1rem,3vw,2.5rem);top:clamp(1rem,2.4vw,1.6rem);z-index:4;display:flex;align-items:center;gap:.65rem;color:var(--color-ink-2);font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.meta:before{content:"";width:2rem;height:3px;background:var(--color-accent)}
.note{position:absolute;right:clamp(1rem,3vw,2.5rem);top:clamp(1rem,2.4vw,1.6rem);z-index:4;max-width:25rem;margin:0;text-align:right;color:var(--color-ink-2);font-size:.7rem;line-height:1.45}.skip{position:absolute;right:clamp(1rem,3vw,2.5rem);bottom:clamp(1rem,3vw,2rem);z-index:8;border:0;background:transparent;color:var(--color-ink-2);font-size:.78rem;font-weight:700;text-decoration:underline;cursor:pointer}
.nodes{position:absolute;inset:0;z-index:1;pointer-events:none}.node{position:absolute;display:flex;align-items:center;gap:.45rem;color:var(--color-ink-2);font-size:clamp(.62rem,1vw,.78rem);font-weight:800;letter-spacing:.07em;text-transform:uppercase;transition:.5s var(--ease-out)}.node:before{content:"";width:.5rem;height:.5rem;border:1px solid;border-radius:50%;background:var(--color-paper);box-shadow:0 0 0 4px color-mix(in oklch,var(--color-paper) 72%,transparent)}.node.active{color:var(--color-accent);transform:scale(1.08)}.node.captured{opacity:.16;transform:scale(.8)}
.n1{left:9%;top:23%}.n2{right:9%;top:25%}.n3{right:10%;top:52%}.n4{left:8%;top:59%}.n5{left:14%;bottom:15%}.n6{right:14%;bottom:15%}
.room{position:absolute;inset:0;z-index:3;display:grid;place-items:center;padding:5rem 1rem 4rem}.demo{position:relative;width:min(46rem,calc(100vw - 2rem));min-height:min(42rem,calc(100svh - 8rem));padding:clamp(1.6rem,4vw,3rem);display:flex;flex-direction:column;justify-content:center;align-items:center;border:1px solid var(--color-rule-strong);background:var(--color-paper-3);box-shadow:0 2rem 6rem var(--color-shadow-deep)}.demo:before{content:"LIVE SPEAKING PREVIEW";position:absolute;left:1.1rem;top:1rem;color:var(--color-accent);font-size:.61rem;font-weight:850;letter-spacing:.13em}.demo:after{content:"";position:absolute;right:1.15rem;top:1.22rem;width:.45rem;height:.45rem;border-radius:50%;background:var(--color-positive);box-shadow:0 0 0 .35rem var(--color-positive-wash)}
.case{width:100%;display:flex;justify-content:space-between;gap:1rem;margin:1rem 0 1.5rem;padding:0 0 .85rem;border-bottom:1px solid var(--color-rule);color:var(--color-ink-2);font-size:.74rem}.case strong{color:var(--color-ink)}.scene{width:100%;max-width:36rem;text-align:center}.eyebrow{margin:0 0 .7rem;color:var(--color-accent);font-size:.68rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.avatar{width:4.15rem;height:4.15rem;margin:0 auto 1rem;display:grid;place-items:center;border-radius:50%;background:var(--color-ink);color:var(--color-paper);font-family:var(--font-display);font-size:2rem}.title{margin:0;font-family:var(--font-display);font-size:clamp(3rem,8vw,6.7rem);font-weight:400;line-height:.9;letter-spacing:-.035em}.title em{display:block;color:var(--color-accent);font-style:normal}.intro{max-width:29rem;margin:1.2rem auto 0;color:var(--color-ink-2);font-size:.8rem;line-height:1.6}.begin{margin-top:1.5rem;min-height:3.3rem;padding:0 1.6rem;border:1px solid var(--color-ink);border-radius:var(--radius-input);background:var(--color-ink);color:var(--color-paper);font-weight:800;cursor:pointer}.begin:hover{background:var(--color-accent);transform:translateY(-2px)}
.speaker{margin:0 0 .55rem;color:var(--color-ink-2);font-size:.67rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.line{min-height:7rem;margin:0;display:grid;place-items:center;font-family:var(--font-display);font-size:clamp(1.75rem,4.3vw,3.1rem);line-height:1.06;letter-spacing:-.02em}.line.you{font-family:var(--font-body);font-size:clamp(1.25rem,3vw,2rem);font-weight:650;line-height:1.25}.caret{display:inline-block;width:.08em;height:.9em;margin-left:.08em;background:var(--color-a

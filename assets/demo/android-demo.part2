ccent);vertical-align:-.06em;animation:blink .7s steps(1) infinite}@keyframes blink{50%{opacity:0}}
.wave{height:2.5rem;display:flex;align-items:center;justify-content:center;gap:.24rem;margin:.8rem 0 1.15rem;opacity:.25}.wave.live{opacity:1}.wave i{width:3px;height:.7rem;border-radius:999px;background:currentColor;animation:wave .78s ease-in-out infinite;animation-play-state:paused}.wave.live i{animation-play-state:running}.wave i:nth-child(2n){animation-delay:-.2s}.wave i:nth-child(3n){animation-delay:-.4s}.wave i:nth-child(5n){animation-delay:-.6s}@keyframes wave{0%,100%{transform:scaleY(.45)}50%{transform:scaleY(2.5)}}
.hold{position:relative;width:min(22rem,94%);height:4.2rem;margin:1rem auto 0;border:1px solid var(--color-ink);border-radius:999px;display:flex;align-items:center;justify-content:center;gap:.65rem;overflow:hidden;background:var(--color-ink);color:var(--color-paper);font-weight:850;cursor:pointer;user-select:none;touch-action:none;box-shadow:0 .75rem 2.5rem var(--color-shadow)}.hold.down{transform:scale(.985);background:var(--color-accent)}.fill{position:absolute;inset:0 auto 0 0;width:calc(var(--p,0)*1%);background:color-mix(in oklch,var(--color-paper) 18%,transparent)}.mic,.hold span:last-child{position:relative}.mic{width:1.1rem;height:1.1rem}.sub{margin:.7rem 0 0;color:var(--color-ink-2);font-size:.71rem}.checks{width:100%;max-width:31rem;margin:1.25rem auto 0;padding-top:1rem;border-top:1px solid var(--color-rule);display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem}.check{min-height:2.45rem;display:flex;align-items:center;justify-content:center;gap:.4rem;border:1px solid var(--color-rule);background:var(--color-paper);color:var(--color-ink-2);font-size:.65rem;font-weight:800;letter-spacing:.055em;text-transform:uppercase;transition:.35s}.check:before{content:"○"}.check.done{border-color:var(--color-positive);background:var(--color-positive-wash);color:var(--color-positive);transform:translateY(-2px)}.check.done:before{content:"✓"}.fly{position:fixed;z-index:110;padding:.48rem .7rem;border:1px solid var(--color-accent);background:var(--color-paper-3);color:var(--color-accent);box-shadow:0 .8rem 2rem var(--color-shadow);font-size:.65rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase;pointer-events:none;transition:transform .68s var(--ease-in-out),opacity .68s var(--ease-in-out)}
.truth{position:absolute;inset:0;z-index:7;display:grid;place-items:center;padding:2rem;background:var(--color-ink);color:var(--color-paper);opacity:0;visibility:hidden;transition:.5s var(--ease-out)}.truth.show{opacity:1;visibility:visible}.truth-inner{width:min(58rem,100%);text-align:center}.truth-kicker{margin:0 0 1.05rem;color:var(--color-accent-2);font-size:.7rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}.truth h2{margin:0;font-family:var(--font-display);font-size:clamp(3rem,8vw,6.5rem);font-weight:400;line-height:.92;letter-spacing:-.035em}.truth h2 span{display:block;color:var(--color-accent-2)}.truth-copy{max-width:38rem;margin:1.25rem auto 0;color:var(--color-paper-2);font-size:clamp(.9rem,2vw,1.08rem);line-height:1.55}
.ctas{width:min(31rem,100%);margin:1.55rem auto 0;display:flex;align-items:stretch;justify-content:center;gap:.65rem}.play{height:3.15rem;display:inline-flex;align-items:center;justify-content:center;transition:.14s}.play:hover,.windows:hover{transform:translateY(-2px)}.play img{height:100%;width:auto}.windows{min-height:3.15rem;padding:.4rem 1rem;display:inline-flex;align-items:center;gap:.65rem;border:1px solid color-mix(in oklch,var(--color-paper) 75%,transparent);border-radius:var(--radius-input);color:var(--color-paper);text-decoration:none;text-align:left;transition:.14s}.windows svg{width:1.05rem;height:1.05rem;flex:0 0 auto}.windows strong,.windows small{display:block;line-height:1.1}.windows strong{font-size:.76rem}.windows small{margin-top:.18rem;color:var(--color-paper-2);font-size:.56rem;letter-spacing:.035em}.continue{margin-top:1.45rem;border:0;background:transparent;color:var(--color-paper-2);cursor:pointer;font-size:.72rem;font-weight:800;letter-spacing:.04em;text-transform:uppercase}.continue:hover{color:var(--color-accent-2)}.continue b{display:inline-block;margin-left:.35rem;color:var(--color-accent-2);font-size:1rem;animation:bob 1.35s ease-in-out infinite}@keyframes bob{50%{transform:translateY(4px)}}.gesture{margin:.3rem 0 0;color:color-mix(in oklch,var(--color-paper-2) 58%,transparent);font-size:.56rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
.morph{position:fixed;z-index:100;margin:0;border:1px solid var(--color-rule-strong);background:var(--color-paper-3);box-shadow:0 2rem 6rem var(--color-shadow-deep);overflow:hidden;pointer-events:none;transform-origin:top left;transition:transform 1s var(--ease-in-out),border-radius 1s var(--ease-in-out)}.morph .cover{position:absolute;inset:0;display:grid;place-items:center;background:var(--color-paper-3);transition:opacity .32s .38s}.morph.go .cover{opacity:0}.morph .cover b{width:4rem;height:4rem;display:grid;place-items:center;background:var(--color-ink);color:var(--color-paper);font-family:var(--font-display);font-size:2rem;transform:rotate(-2deg)}.morph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top;opacity:0;transition:opacity .35s .45s}.morph.go img{opacity:1}
@media(max-width:780px){.note{display:none}.node{font-size:.56rem}.n1{left:2%;top:22%}.n2{right:2%;top:24%}.n3{right:1%;top:52%}.n4{left:1%;top:59%}.n5{left:3%;bottom:12%}.n6{right:3%;bottom:12%}.room{padding:4.6rem .65rem 3.8rem}.demo{width:calc(100vw - 1.3rem);min-height:min(39rem,calc(100svh - 6.5rem));padding:2.4rem 1rem 1.3rem}.truth{padding:1.35rem}.truth h2{font-size:clamp(2.8rem,14vw,4.7rem)}.ctas{margin-top:1.3rem;gap:.5rem}.play{height:3rem}.windows{min-height:3rem;padding-inline:.7rem}}
@media(max-width:480px){.case{font-size:.68rem}.line{min-height:6.4rem}.hold{width:100%}.ctas{display:grid;grid-template-columns:1fr 1fr;w
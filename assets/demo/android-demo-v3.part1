<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0c1320">
<title>Bedside English — Bed 23</title>
<meta name="description" content="An immersive speaking preview of Bedside English: Talk & Train.">
<style>
:root{--ink:#0d1626;--paper:#f4efdf;--paper2:#fffaf0;--navy:#0c1320;--navy2:#111c2c;--red:#d96c4d;--red2:#f08a67;--muted:#697384;--rule:rgba(255,255,255,.15);--positive:#2d7f62;--ease:cubic-bezier(.2,.8,.2,1)}
*{box-sizing:border-box}html,body{margin:0;width:100%;min-height:100%;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--navy);color:#f7f1e4;-webkit-font-smoothing:antialiased}body{overflow:hidden}button,a{font:inherit;color:inherit}button{cursor:pointer}button:focus-visible,a:focus-visible{outline:3px solid #f6c7a9;outline-offset:4px}[hidden]{display:none!important}
.preview{position:fixed;inset:0;overflow:hidden;background:var(--navy)}
.noise{position:absolute;inset:0;pointer-events:none;opacity:.2;background-image:radial-gradient(rgba(255,255,255,.12) .7px,transparent .7px);background-size:6px 6px;mask-image:linear-gradient(to bottom,#000,transparent 85%)}
.skip{position:fixed;right:max(14px,env(safe-area-inset-right));bottom:max(14px,env(safe-area-inset-bottom));z-index:40;border:0;background:transparent;color:rgba(247,241,228,.5);font-size:12px;font-weight:700;text-decoration:underline;text-underline-offset:3px}

/* PRESSURE OPENING */
.brief{position:absolute;inset:0;z-index:20;display:grid;place-items:center;padding:24px;background:radial-gradient(circle at 50% 44%,#18253a 0,transparent 48%),linear-gradient(180deg,#0b121e,#0c1320 65%,#09111d);transition:opacity .5s var(--ease),transform .7s var(--ease),visibility .5s}
.brief.leave{opacity:0;transform:scale(1.035);visibility:hidden}.brief::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(255,255,255,.035),transparent 16%,transparent 84%,rgba(255,255,255,.025));pointer-events:none}
.hud{position:absolute;left:max(18px,env(safe-area-inset-left));right:max(18px,env(safe-area-inset-right));top:max(16px,env(safe-area-inset-top));display:flex;justify-content:space-between;gap:16px;color:rgba(247,241,228,.58);font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.hud strong{color:#f7f1e4}.hud .live{display:flex;align-items:center;gap:8px}.hud .live::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--red);box-shadow:0 0 0 5px rgba(217,108,77,.13)}
.team{position:absolute;left:50%;bottom:-1.5%;width:min(840px,110vw);height:34vh;transform:translateX(-50%);opacity:.12;filter:blur(.4px);pointer-events:none}.person{position:absolute;bottom:0;width:20%;height:78%;border-radius:50% 50% 12% 12%;background:linear-gradient(180deg,#f7f1e4 0 24%,#f7f1e4 25% 100%)}.person::before{content:"";position:absolute;left:50%;top:-23%;width:46%;aspect-ratio:1;border-radius:50%;background:#f7f1e4;transform:translateX(-50%)}.person.p1{left:5%;height:64%;opacity:.62}.person.p2{left:24%;height:88%;opacity:.95}.person.p3{left:49%;height:80%;opacity:.76}.person.p4{left:71%;height:69%;opacity:.55}
.attending{position:relative;width:min(780px,92vw);min-height:420px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;transform:translateY(-2vh)}
.label{margin:0 0 28px;color:rgba(247,241,228,.54);font-size:11px;font-weight:900;letter-spacing:.22em;text-transform:uppercase}.label::after{content:"";display:block;width:34px;height:2px;margin:12px auto 0;background:var(--red)}
.line{margin:0;min-height:1.25em;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:clamp(38px,7vw,78px);font-weight:850;line-height:1.02;letter-spacing:-.035em;text-wrap:balance;text-shadow:0 12px 45px rgba(0,0,0,.25)}
.line .accent{color:#ffab87}.subline{min-height:1.5em;margin:18px 0 0;color:rgba(247,241,228,.63);font-size:clamp(13px,1.7vw,16px);font-weight:700;letter-spacing:.035em}.pressure{position:absolute;left:50%;bottom:34px;transform:translateX(-50%);display:flex;align-items:center;gap:11px;color:rgba(247,241,228,.58);font-size:10px;font-weight:900;letter-spacing:.14em;text-transform:uppercase;opacity:0;transition:opacity .35s}.pressure.show{opacity:1}.pressure b{color:#f7f1e4;font-variant-numeric:tabular-nums;font-size:13px}.pulse-ring{width:8px;height:8px;border-radius:50%;background:var(--red);box-shadow:0 0 0 0 rgba(217,108,77,.32);animation:pulse 1.25s infinite}@keyframes pulse{70%{box-shadow:0 0 0 9px rgba(217,108,77,0)}100%{box-shadow:0 0 0 0 rgba(217,108,77,0)}}
.impact{animation:impact .28s var(--ease)}@keyframes impact{0%{transform:translateY(4px);opacity:.25;filter:blur(2px)}100%{transform:none;opacity:1;filter:none}}

/* ROOM */
.room{position:absolute;inset:0;z-index:10;background:radial-gradient(circle at 50% 40%,#fffaf0 0 20%,#f1ead8 68%,#e9e1cd);color:var(--ink);opacity:0;visibility:hidden;transform:scale(.985);transition:opacity .65s var(--ease),transform .85s var(--ease),visibility .65s}.room.show{opacity:1;visibility:visible;transform:none}.room-grid{position:absolute;inset:0;opacity:.32;background-image:linear-gradient(to right,rgba(16,24,39,.055) 1px,transparent 1px),linear-gradient(to bottom,rgba(16,24,39,.04) 1px,transparent 1px);background-size:80px 80px;mask-image:radial-gradient(circle at 50% 50%,#000 0 34%,transparent 76%)}
.room-top{position:absolute;left:max(16px,env(safe-area-inset-left));right:max(16px,env(safe-area-inset-right));top:max(14px,env(safe-area-inset-top));z-index:3;display:flex;justify-content:space-between;align-items:flex-start;color:#697384;font-size:10px;font-weight:900;letter-spacing:.13em;text-transform:uppercase}.room-top strong{display:block;color:var(--ink);font-size:12px;letter-spacing:.08em}.returning{display:flex;align-items:center;gap:7px}.returning::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--red)}.r
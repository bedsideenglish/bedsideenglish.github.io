unction role(r){const patient=r==='patient';speaker.textContent=patient?'Patient':'Your turn';avatar.textContent=patient?'P':'Y';line.classList.toggle('you',!patient)}function type(text,d=1000){line.innerHTML='';const n=document.createTextNode(''),c=document.createElement('span');c.className='caret';line.append(n,c);const t=performance.now();function tick(now){const q=Math.min(1,(now-t)/d);n.nodeValue=text.slice(0,Math.max(1,Math.floor(text.length*q)));if(q<1)requestAnimationFrame(tick);else c.remove()}requestAnimationFrame(tick)}
function patient(text,next){role('patient');hold.hidden=true;sub.hidden=true;live(true);type(text,Math.min(1450,Math.max(800,text.length*24)));say(text,'patient',()=>{live(false);setTimeout(()=>next&&next(),400)})}function prepare(){role('doctor');line.textContent='';p=base=0;hold.style.setProperty('--p','0');hold.hidden=false;sub.hidden=false;holdText.textContent=ti?'HOLD — KEEP GOING':'HOLD TO SPEAK';sub.textContent=ti?'She is waiting. Keep the history moving.':'No choices. Ask the question out loud.';live(false);document.querySelector(`[data-node="${turns[ti].capture}"]`)?.classList.add('active')}function render(){const text=turns[ti].doctor,q=Math.max(0,Math.min(1,p)),n=Math.floor(text.length*q);line.innerHTML='';line.append(document.createTextNode(text.slice(0,n)));if(q>0&&q<1){const c=document.createElement('span');c.className='caret';line.append(c)}hold.style.setProperty('--p',String(q*100))}function startHold(){if(down||busy||hold.hidden)return;down=true;hold.classList.add('down');holdText.textContent='SPEAKING…';live(true);start=performance.now();base=p;const words=turns[ti].doctor.split(/\s+/),wi=Math.min(words.length-1,Math.floor(words.length*p));say(words.slice(wi).join(' ')||turns[ti].doctor,'doctor');function tick(now){if(!down)return;p=Math.min(1,base+(now-start)/2450);render();if(p>=1){finish();return}raf=requestAnimationFrame(tick)}raf=requestAnimationFrame(tick)}function stopHold(){if(!down)return;down=false;cancelAnimationFrame(raf);stop();hold.classList.remove('down');live(false);if(p<1)holdText.textContent=ti?'HOLD — KEEP GOING':'HOLD TO CONTINUE'}
function capture(key){return new Promise(resolve=>{const node=document.querySelector(`[data-node="${key}"]`),target=document.querySelector(`[data-check="${key}"]`);if(!target){resolve();return}const a=(node||target).getBoundingClientRect(),b=target.getBoundingClientRect(),f=document.createElement('div');f.className='fly';f.textContent=key==='provoking'?'Provoking factors':key;f.style.left=a.left+'px';f.style.top=a.top+'px';document.body.append(f);const r=f.getBoundingClientRect(),dx=b.left+b.width/2-r.left-r.width/2,dy=b.top+b.height/2-r.top-r.height/2;requestAnimationFrame(()=>{f.style.transform=`translate(${dx}px,${dy}px) scale(.72)`;f.style.opacity='0'});node?.classList.remove('active');node?.classList.add('captured');setTimeout(()=>{target.classList.add('done');f.remove();resolve()},690)})}async function finish(){down=false;busy=true;cancelAnimationFrame(raf);stop();p=1;render();hold.classList.remove('down');hold.hidden=true;sub.hidden=true;live(false);await capture(turns[ti].capture);patient(turns[ti].response,()=>{if(ti<turns.length-1){ti++;busy=false;setTimeout(prepare,250)}else setTimeout(showTruth,500)})}function beginEncounter(){begin.hidden=true;intro.hidden=true;hero.hidden=true;conversation.hidden=false;document.querySelector('[data-node="onset"]')?.classList.add('captured');patient(turns[0].patient,prepare)}function showTruth(){truth.classList.add('show');final=true;readyAt=performance.now()+500}
async function fullLanding(){if(transitioning)return;transitioning=true;final=false;stopHold();stop();const html=await landingHTML;if(html){history.replaceState(null,'','android.html');document.open();document.write(html);document.close()}else location.href='android.html'}function morph(){if(transitioning)return;transitioning=true;final=false;stop();if(matchMedia('(prefers-reduced-motion:reduce)').matches){transitioning=false;fullLanding();return}const a=demo.getBoundingClientRect(),c=document.createElement('div');c.className='morph';Object.assign(c.style,{left:a.left+'px',top:a.top+'px',width:a.width+'px',height:a.height+'px'});c.innerHTML='<div class="cover"><b>+</b></div><img src="assets/android/encounter-live.webp" alt="">';document.body.append(c);truth.classList.remove('show');preview.style.opacity='0';const ratio=780/1636,maxH=innerHeight*.72,maxW=Math.min(296,innerWidth*.72),w=Math.min(maxW,maxH*ratio),h=w/ratio,x=(innerWidth-w)/2,y=(innerHeight-h)/2;requestAnimationFrame(()=>{c.classList.add('go');c.style.transform=`translate(${x-a.left}px,${y-a.top}px) scale(${w/a.width},${h/a.height})`});setTimeout(()=>{c.remove();transitioning=false;fullLanding()},1050)}
begin.addEventListener('click',beginEncounter);$('#skip').addEventListener('click',fullLanding);go.addEventListener('click',morph);hold.addEventListener('pointerdown',e=>{e.preventDefault();try{hold.setPointerCapture(e.pointerId)}catch{}startHold()});hold.addEventListener('pointerup',e=>{e.preventDefault();stopHold()});hold.addEventListener('pointercancel',stopHold);hold.addEventListener('lostpointercapture',stopHold);hold.addEventListener('contextmenu',e=>e.preventDefault());hold.addEventListener('keydown',e=>{if((e.code==='Space'||e.code==='Enter')&&!e.repeat){e.preventDefault();startHold()}});hold.addEventListener('keyup',e=>{if(e.code==='Space'||e.code==='Enter'){e.preventDefault();stopHold()}});addEventListener('wheel',e=>{if(final&&performance.now()>=readyAt&&e.deltaY>28)morph()},{passive:true});addEventListener('touchstart',e=>{if(final&&e.touches.length===1)touchY=e.touches[0].clientY},{passive:true});addEventListener('touchend',e=>{if(!final||touchY==null||performance.now()<readyAt)return;const y=e.changedTouches[0]?.clientY??touchY;if(touchY-y>42)morph();touchY=null},{passive:true});addEventListener('keydown',e=>{if(final&&performance.now()>=readyAt&&(e.code==='ArrowDown'||e.code==='PageDown'))morph()});document.addEventListener('visibilitychange',()=>{if(document.hidden){stopHold();stop()}});addEventListener('beforeunload',stop)})();
</script>
</body></html>
